{
  "meta": {
    "name": "Linux CLI in 10 Days — Cards + Graph prototype",
    "sourceOfTruth": "Prototype subset derived from the current project knowledge map.",
    "note": "COMMAND_TREE.md is a derived overview, not a second knowledge source."
  },
  "areas": [
    {
      "id": "filesystem",
      "label": "File operations",
      "description": "Navigate, inspect, create, copy, move, rename, and remove filesystem objects.",
      "commands": [
        "pwd",
        "ls",
        "cd",
        "mkdir",
        "touch",
        "cp",
        "mv",
        "rm"
      ]
    },
    {
      "id": "reading",
      "label": "Reading text",
      "description": "Read, browse, and inspect text files.",
      "commands": [
        "cat",
        "less",
        "head",
        "tail"
      ]
    },
    {
      "id": "search",
      "label": "Search",
      "description": "Search inside text and locate filesystem objects.",
      "commands": [
        "grep",
        "find"
      ]
    },
    {
      "id": "text-processing",
      "label": "Text processing",
      "description": "Connect output, redirect it, count, order, group, and extract text fields.",
      "commands": [
        "pipe",
        "redirect-overwrite",
        "redirect-append",
        "wc",
        "sort",
        "uniq",
        "cut"
      ]
    },
    {
      "id": "permissions",
      "label": "Permissions",
      "description": "Inspect and change permissions, ownership, and elevated access.",
      "commands": [
        "ls-l",
        "chmod",
        "chown",
        "sudo"
      ]
    },
    {
      "id": "processes",
      "label": "Processes",
      "description": "Inspect, monitor, and safely stop running processes.",
      "commands": [
        "ps",
        "top",
        "kill"
      ]
    },
    {
      "id": "networking",
      "label": "Networking",
      "description": "Inspect interfaces, test reachability, query web services, and inspect sockets.",
      "commands": [
        "ip",
        "ping",
        "curl",
        "ss"
      ]
    },
    {
      "id": "services",
      "label": "Services & logs",
      "description": "Inspect systemd services and investigate journal events.",
      "commands": [
        "systemctl",
        "journalctl"
      ]
    }
  ],
  "nodes": {
    "pwd": {
