    },
    "chmod-600": {
      "label": "600",
      "type": "variant",
      "description": "Owner read/write only.",
      "syntax": "chmod 600 report.txt",
      "children": []
    },
    "chmod-640": {
      "label": "640",
      "type": "variant",
      "description": "Owner read/write; group read; others none.",
      "syntax": "chmod 640 report.txt",
      "children": []
    },
