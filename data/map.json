      "description": "Go to the filesystem root.",
      "syntax": "cd /",
      "children": []
    },
    "cd-home": {
      "label": "~",
      "type": "variant",
      "description": "Go to the current user's home directory.",
      "syntax": "cd ~",
      "children": []
    },
    "cd-parent": {
      "label": "..",
