{
  "cloud": {
    "linux": {
      "center": "LINUX",
      "type": "root",
      "nodes": [
        {
          "id": "filesystem",
          "label": "Filesystem",
          "type": "domain",
          "description": "Navigate and manage files and directories.",
          "target": "filesystem"
        },
        {
          "id": "text",
          "label": "Text",
          "type": "domain",
          "description": "Read and inspect text file contents.",
          "target": "text"
        },
        {
          "id": "search",
          "label": "Search",
          "type": "domain",
          "description": "Search file contents and locate filesystem objects.",
          "target": "search"
        }
      ]
    },
    "ls": {
      "center": "ls",
      "type": "command",
      "nodes": [
        {
          "id": "ls-a",
          "label": "-a",
          "type": "option",
          "syntax": "ls -a",
          "description": "Show all entries, including hidden files."
        },
        {
          "id": "ls-l",
          "label": "-l",
          "type": "option",
          "syntax": "ls -l",
          "description": "Show a detailed long-format listing.",
          "target": "ls-l"
        },
        {
          "id": "ls-la",
          "label": "-la",
          "type": "variant",
          "syntax": "ls -la",
          "description": "Show a detailed listing including hidden files."
        },
        {
          "id": "ls-h",
          "label": "-h",
          "type": "option",
          "syntax": "ls -lh",
          "description": "Show file sizes in human-readable form."
        },
        {
          "id": "ls-R",
          "label": "-R",
          "type": "option",
          "syntax": "ls -R",
          "description": "List directories recursively."
        }
      ]
    },
    "ls-l": {
      "center": "ls -l",
      "type": "variant",
      "nodes": [
        {
          "id": "permissions",
          "label": "permissions",
          "type": "output-concept",
          "description": "Shows the file type and read, write, and execute permission bits."
        },
        {
          "id": "owner",
          "label": "owner",
          "type": "output-concept",
          "description": "Shows the user that owns the file or directory."
        },
        {
          "id": "group",
          "label": "group",
          "type": "output-concept",
          "description": "Shows the group associated with the file or directory."
        },
        {
          "id": "size",
          "label": "size",
          "type": "output-concept",
          "description": "Shows the file size in bytes unless another display option changes it."
        },
        {
          "id": "modified",
          "label": "modified",
          "type": "output-concept",
          "description": "Shows the last modification time."
        },
        {
          "id": "filename",
          "label": "filename",
          "type": "output-concept",
          "description": "Shows the file or directory name."
        }
      ]
    },
    "mkdir": {
      "center": "mkdir",
      "type": "command",
      "nodes": [
        {
          "id": "mkdir-basic",
          "label": "directory",
          "type": "syntax",
          "syntax": "mkdir projects",
          "description": "Create a new directory named projects."
        },
        {
          "id": "mkdir-multiple",
          "label": "multiple",
          "type": "variant",
          "syntax": "mkdir documents backups temp",
          "description": "Create several directories with one command."
        },
        {
          "id": "mkdir-p",
          "label": "-p",
          "type": "option",
          "syntax": "mkdir -p documents/projects/linux",
          "description": "Create missing parent directories along the path."
        }
      ]
    },
    "touch": {
      "center": "touch",
      "type": "command",
      "nodes": [
        {
          "id": "touch-basic",
          "label": "file",
          "type": "syntax",
          "syntax": "touch notes.txt",
          "description": "Create an empty file if it does not already exist."
        },
        {
          "id": "touch-multiple",
          "label": "multiple",
          "type": "variant",
          "syntax": "touch notes.txt todo.txt",
          "description": "Create several empty files with one command."
        },
        {
          "id": "touch-path",
          "label": "path",
          "type": "variant",
          "syntax": "touch documents/report.txt",
          "description": "Create a file at a path inside an existing directory."
        }
      ]
    },
    "cp": {
      "center": "cp",
      "type": "command",
      "nodes": [
        {
          "id": "cp-file-dir",
          "label": "to directory",
          "type": "variant",
          "syntax": "cp notes.txt backups/",
          "description": "Copy a file into another directory and keep its name."
        },
        {
          "id": "cp-new-name",
          "label": "new name",
          "type": "variant",
          "syntax": "cp report.txt report-copy.txt",
          "description": "Copy a file and give the copy a different name."
        },
        {
          "id": "cp-model",
          "label": "source → destination",
          "type": "syntax",
          "syntax": "cp source destination",
          "description": "cp reads a source path and writes a copy to the destination."
        }
      ]
    },
    "mv": {
      "center": "mv",
      "type": "command",
      "nodes": [
        {
          "id": "mv-move",
          "label": "move",
          "type": "variant",
          "syntax": "mv todo.txt documents/",
          "description": "Move an existing file into another directory."
        },
        {
          "id": "mv-rename",
          "label": "rename",
          "type": "variant",
          "syntax": "mv notes.txt notes-old.txt",
          "description": "Rename an existing file."
        },
        {
          "id": "mv-model",
          "label": "source → destination",
          "type": "syntax",
          "syntax": "mv source destination",
          "description": "mv changes the path or name of an existing object rather than creating a copy."
        }
      ]
    },
    "rm": {
      "center": "rm",
      "type": "command",
      "nodes": [
        {
          "id": "rm-file",
          "label": "file",
          "type": "syntax",
          "syntax": "rm file.txt",
          "description": "Remove a file. There is normally no recycle bin in this workflow."
        },
        {
          "id": "rm-r",
          "label": "-r",
          "type": "option",
          "syntax": "rm -r directory",
          "description": "Recursively remove a directory and its contents. DANGEROUS: verify the path before running it."
        },
        {
          "id": "rmdir",
          "label": "rmdir",
          "type": "related-concept",
          "syntax": "rmdir empty-directory",
          "description": "Remove an empty directory only."
        }
      ]
    },
    "cat": {
      "center": "cat",
      "type": "command",
      "nodes": [
        {
          "id": "cat-file",
          "label": "whole file",
          "type": "syntax",
          "syntax": "cat system-notes.txt",
          "description": "Display the complete contents of a small text file."
        },
        {
          "id": "cat-model",
          "label": "file → terminal",
          "type": "related-concept",
          "syntax": "cat FILE",
          "description": "Read a file and write its complete contents to standard output."
        }
      ]
    },
    "less": {
      "center": "less",
      "type": "command",
      "nodes": [
        {
          "id": "less-file",
          "label": "browse",
          "type": "syntax",
          "syntax": "less system-notes.txt",
          "description": "Open a text file for interactive browsing."
        },
        {
          "id": "less-quit",
          "label": "q",
          "type": "related-concept",
          "syntax": "q",
          "description": "Quit the less viewer and return to the shell."
        }
      ]
    },
    "head": {
      "center": "head",
      "type": "command",
      "nodes": [
        {
          "id": "head-default",
          "label": "first 10",
          "type": "syntax",
          "syntax": "head FILE",
          "description": "Show the first 10 lines of a file."
        },
        {
          "id": "head-n",
          "label": "-n N",
          "type": "option",
          "syntax": "head -n 3 app.log",
          "description": "Show the first N lines of a file."
        }
      ]
    },
    "tail": {
      "center": "tail",
      "type": "command",
      "nodes": [
        {
          "id": "tail-default",
          "label": "last 10",
          "type": "syntax",
          "syntax": "tail FILE",
          "description": "Show the last 10 lines of a file."
        },
        {
          "id": "tail-n",
          "label": "-n N",
          "type": "option",
          "syntax": "tail -n 3 app.log",
          "description": "Show the last N lines of a file."
        },
        {
          "id": "tail-f",
          "label": "-f",
          "type": "option",
          "syntax": "tail -f app.log",
          "description": "Follow a growing file and display new lines as they are written."
        }
      ]
    },
    "grep": {
      "center": "grep",
      "type": "command",
      "nodes": [
        {
          "id": "grep-basic",
          "label": "pattern",
          "type": "syntax",
          "syntax": "grep ERROR app.log",
          "description": "Show lines in app.log that contain ERROR."
        },
        {
          "id": "grep-i",
          "label": "-i",
          "type": "option",
          "syntax": "grep -i error app.log",
          "description": "Ignore letter case while matching."
        },
        {
          "id": "grep-n",
          "label": "-n",
          "type": "option",
          "syntax": "grep -n ERROR app.log",
          "description": "Show the line number for each matching line."
        },
        {
          "id": "grep-v",
          "label": "-v",
          "type": "option",
          "syntax": "grep -v ERROR app.log",
          "description": "Invert the match and show lines that do not contain ERROR."
        },
        {
          "id": "grep-c",
          "label": "-c",
          "type": "option",
          "syntax": "grep -c ERROR app.log",
          "description": "Output the number of matching lines."
        },
        {
          "id": "grep-E",
          "label": "-E",
          "type": "option",
          "syntax": "grep -E \"ERROR|WARNING\" app.log",
          "description": "Use an extended pattern to match alternatives such as ERROR or WARNING."
        },
        {
          "id": "grep-w",
          "label": "-w",
          "type": "option",
          "syntax": "grep -w INFO app.log",
          "description": "Match INFO as a whole word."
        }
      ]
    },
    "find": {
      "center": "find",
      "type": "command",
      "nodes": [
        {
          "id": "find-name",
          "label": "-name",
          "type": "option",
          "syntax": "find . -name \"app.log\"",
          "description": "Search from the current directory downward for objects named app.log."
        },
        {
          "id": "find-wildcard",
          "label": "*.log",
          "type": "variant",
          "syntax": "find . -name \"*.log\"",
          "description": "Find names ending in .log below the current directory."
        },
        {
          "id": "find-iname",
          "label": "-iname",
          "type": "option",
          "syntax": "find . -iname \"*.txt\"",
          "description": "Match names without case sensitivity."
        },
        {
          "id": "find-type-f",
          "label": "-type f",
          "type": "option",
          "syntax": "find . -type f -name \"*.log\"",
          "description": "Restrict the search to regular files."
        },
        {
          "id": "find-type-d",
          "label": "-type d",
          "type": "option",
          "syntax": "find . -type d",
          "description": "Restrict the search to directories."
        }
      ]
    },
    "filesystem": {
      "center": "Filesystem",
      "type": "domain",
      "nodes": [
        {
          "id": "pwd",
          "label": "pwd",
          "type": "command",
          "description": "Print the current working directory."
        },
        {
          "id": "cd",
          "label": "cd",
          "type": "command",
          "description": "Change the current working directory."
        },
        {
          "id": "ls",
          "label": "ls",
          "type": "command",
          "description": "List directory contents.",
          "target": "ls"
        },
        {
          "id": "mkdir",
          "label": "mkdir",
          "type": "command",
          "description": "Create directories.",
          "target": "mkdir"
        },
        {
          "id": "touch",
          "label": "touch",
          "type": "command",
          "description": "Create an empty file or update a file timestamp.",
          "target": "touch"
        },
        {
          "id": "cp",
          "label": "cp",
          "type": "command",
          "description": "Copy files or directories.",
          "target": "cp"
        },
        {
          "id": "mv",
          "label": "mv",
          "type": "command",
          "description": "Move or rename files and directories.",
          "target": "mv"
        },
        {
          "id": "rm",
          "label": "rm",
          "type": "command",
          "description": "Remove files. Use recursive removal with care.",
          "target": "rm"
        }
      ]
    },
    "text": {
      "center": "Text",
      "type": "domain",
      "nodes": [
        {
          "id": "cat",
          "label": "cat",
          "type": "command",
          "description": "Display file contents.",
          "target": "cat"
        },
        {
          "id": "less",
          "label": "less",
          "type": "command",
          "description": "Browse a text file interactively.",
          "target": "less"
        },
        {
          "id": "head",
          "label": "head",
          "type": "command",
          "description": "Display the beginning of a file.",
          "target": "head"
        },
        {
          "id": "tail",
          "label": "tail",
          "type": "command",
          "description": "Display the end of a file or follow new lines.",
          "target": "tail"
        }
      ]
    },
    "search": {
      "center": "Search",
      "type": "domain",
      "nodes": [
        {
          "id": "grep",
          "label": "grep",
          "type": "command",
          "description": "Search text and output matching lines.",
          "target": "grep"
        },
        {
          "id": "find",
          "label": "find",
          "type": "command",
          "description": "Search directory trees for matching files or directories.",
          "target": "find"
        }
      ]
    }
  },
  "domains": [
    {
      "domain": "Filesystem",
      "tasks": [
        {
          "task": "Show the current directory",
          "node": "pwd",
          "command": "pwd",
          "example": "pwd"
        },
        {
          "task": "Move to another directory",
          "node": "cd",
          "command": "cd",
          "example": "cd /home/sadmin"
        },
        {
          "task": "Move to the parent directory",
          "node": "cd",
          "command": "cd",
          "example": "cd .."
        },
        {
          "task": "Return to the home directory",
          "node": "cd",
          "command": "cd",
          "example": "cd ~"
        },
        {
          "task": "List directory contents",
          "node": "ls",
          "command": "ls",
          "example": "ls"
        },
        {
          "task": "Show hidden files",
          "node": "ls-a",
          "command": "ls",
          "options": [
            "-a"
          ],
          "example": "ls -a"
        },
        {
          "task": "Show a detailed directory listing",
          "node": "ls-l",
          "command": "ls",
          "options": [
            "-l"
          ],
          "example": "ls -l"
        },
        {
          "task": "Create a directory",
          "node": "mkdir",
          "command": "mkdir",
          "example": "mkdir projects"
        },
        {
          "task": "Create nested directories",
          "node": "mkdir-p",
          "command": "mkdir",
          "options": [
            "-p"
          ],
          "example": "mkdir -p documents/projects/linux"
        },
        {
          "task": "Create an empty file",
          "node": "touch",
          "command": "touch",
          "example": "touch notes.txt"
        },
        {
          "task": "Copy a file",
          "node": "cp",
          "command": "cp",
          "example": "cp notes.txt backups/"
        },
        {
          "task": "Move a file",
          "node": "mv-move",
          "command": "mv",
          "example": "mv todo.txt documents/"
        },
        {
          "task": "Rename a file",
          "node": "mv-rename",
          "command": "mv",
          "example": "mv notes.txt notes-old.txt"
        },
        {
          "task": "Remove a file",
          "node": "rm-file",
          "command": "rm",
          "example": "rm file.txt"
        },
        {
          "task": "Remove a directory recursively",
          "node": "rm-r",
          "command": "rm",
          "options": [
            "-r"
          ],
          "example": "rm -r backups"
        }
      ]
    },
    {
      "domain": "Text",
      "tasks": [
        {
          "task": "Read a small text file",
          "node": "cat-file",
          "command": "cat",
          "example": "cat system-notes.txt"
        },
        {
          "task": "Browse a long text file",
          "node": "less-file",
          "command": "less",
          "example": "less system-notes.txt"
        },
        {
          "task": "Show the first lines of a file",
          "node": "head-n",
          "command": "head",
          "options": [
            "-n"
          ],
          "example": "head -n 3 app.log"
        },
        {
          "task": "Show the last lines of a file",
          "node": "tail-n",
          "command": "tail",
          "options": [
            "-n"
          ],
          "example": "tail -n 3 app.log"
        },
        {
          "task": "Follow new log entries",
          "node": "tail-f",
          "command": "tail",
          "options": [
            "-f"
          ],
          "example": "tail -f app.log"
        }
      ]
    },
    {
      "domain": "Search",
      "tasks": [
        {
          "task": "Find matching text in a file",
          "node": "grep-basic",
          "command": "grep",
          "example": "grep ERROR app.log"
        },
        {
          "task": "Search text without case sensitivity",
          "node": "grep-i",
          "command": "grep",
          "options": [
            "-i"
          ],
          "example": "grep -i error app.log"
        },
        {
          "task": "Show line numbers for matches",
          "node": "grep-n",
          "command": "grep",
          "options": [
            "-n"
          ],
          "example": "grep -n ERROR app.log"
        },
        {
          "task": "Show lines that do not match",
          "node": "grep-v",
          "command": "grep",
          "options": [
            "-v"
          ],
          "example": "grep -v ERROR app.log"
        },
        {
          "task": "Count matching lines",
          "node": "grep-c",
          "command": "grep",
          "options": [
            "-c"
          ],
          "example": "grep -c ERROR app.log"
        },
        {
          "task": "Search for alternative patterns",
          "node": "grep-E",
          "command": "grep",
          "options": [
            "-E"
          ],
          "example": "grep -E \"ERROR|WARNING\" app.log"
        },
        {
          "task": "Find a file by name",
          "node": "find-name",
          "command": "find",
          "options": [
            "-name"
          ],
          "example": "find . -name \"app.log\""
        },
        {
          "task": "Find files by extension",
          "node": "find-wildcard",
          "command": "find",
          "options": [
            "-name"
          ],
          "example": "find . -name \"*.log\""
        },
        {
          "task": "Find names without case sensitivity",
          "node": "find-iname",
          "command": "find",
          "options": [
            "-iname"
          ],
          "example": "find . -iname \"*.txt\""
        },
        {
          "task": "Find regular files only",
          "node": "find-type-f",
          "command": "find",
          "options": [
            "-type",
            "f"
          ],
          "example": "find . -type f -name \"*.log\""
        },
        {
          "task": "Find directories only",
          "node": "find-type-d",
          "command": "find",
          "options": [
            "-type",
            "d"
          ],
          "example": "find . -type d"
        }
      ]
    }
  ]
}
